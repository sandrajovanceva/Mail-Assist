# Copy this file to .env and fill in your keys

# Gemini API key — free tier, no credit card: https://aistudio.google.com/apikey
# Note: the $300 Google Cloud free trial does NOT cover Gemini API usage
# (excluded since March 2026), so the free tier below is the free option.
GEMINI_API_KEY=AIza...

# Google Cloud OAuth 2.0 client (https://console.cloud.google.com -> APIs & Services -> Credentials)
# Create an "OAuth client ID" of type "Web application" and add the redirect URI below.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where the frontend runs (used for CORS + post-login redirect)
FRONTEND_URL=http://localhost:5180

# Database — defaults to a local SQLite file (zero setup).
# To use PostgreSQL instead, run `docker compose up -d` in the repo root and uncomment:
# DATABASE_URL=postgresql+psycopg://mailassist:mailassist@localhost:5433/mailassist

# Models (swap freely for the thesis evaluation chapter).
# The classifier runs on every synced email, so it defaults to a lite model with
# a generous free-tier daily quota. The drafter only runs on demand.
# Check your own per-model quotas at https://aistudio.google.com/rate-limit
CLASSIFIER_MODEL=gemini-3.5-flash-lite
DRAFTER_MODEL=gemini-3.8-flash

# Optional thinking depth ("low"/"medium"/"high", Gemini 3+ only).
# Leave empty unless you're measuring the quality/cost tradeoff.
CLASSIFIER_THINKING_LEVEL=
DRAFTER_THINKING_LEVEL=

# Sync behaviour — keep concurrency low on a free-tier key (per-minute limits)
SYNC_MAX_EMAILS=20
SYNC_CONCURRENCY=4
LLM_MAX_RETRIES=4
